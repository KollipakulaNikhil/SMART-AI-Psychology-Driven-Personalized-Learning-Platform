# ── Database (same value as apps/web) ───────────────────────────────────────
MONGODB_URI=

# ── Vercel Blob storage (same token as apps/web) ────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── AI content providers — used by the research pipeline's ideation step ───
# OpenAI is tried first, then Gemini, then Groq.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ── Research Lab prior-art search ───────────────────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=
PATENTSVIEW_API_KEY=
RESEARCH_CONTACT_EMAIL=

# ── ffmpeg overrides (leave blank to use the bundled ffmpeg-static/ffprobe-static) ──
FFMPEG_PATH=
FFPROBE_PATH=
# Optional local path to an mp3 mixed under every lesson video, if bundled into the worker image.
BACKGROUND_MUSIC_PATH=

# ── AI-animated lesson video — Wan 2.2 (open weights) ──────────────────────
# Leave WAN_PROVIDER blank to keep the classic board video.
#   comfyui   = a ComfyUI server with Wan 2.2 TI2V-5B installed (needs a GPU with ~8 GB+ VRAM)
#   replicate = the same open model on Replicate's hosted GPUs (pay per clip)
WAN_PROVIDER=
WAN_COMFYUI_URL=http://127.0.0.1:8188
# Optional: your own API-format workflow JSON (placeholders %PROMPT% %NEGATIVE% "%SEED%")
WAN_COMFYUI_WORKFLOW_PATH=
WAN_WIDTH=1280
WAN_HEIGHT=704
WAN_FRAMES=121
WAN_FPS=24
WAN_STEPS=20
REPLICATE_API_TOKEN=
WAN_REPLICATE_MODEL=wan-video/wan-2.2-t2v-fast
# Extra model inputs as JSON, e.g. {"resolution":"480p"} — check the model's API page for its input names
WAN_REPLICATE_INPUT=
WAN_MAX_CLIPS_PER_SLIDE=2
WAN_MAX_CLIPS_PER_LESSON=12
WAN_CLIP_TIMEOUT_MIN=20

# ── Render injects this automatically; only needed for local dev ──────────
PORT=4000
