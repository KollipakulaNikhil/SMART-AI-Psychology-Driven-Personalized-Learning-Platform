# ── Database (same value as apps/web) ───────────────────────────────────────
MONGODB_URI=

# ── Vercel Blob storage (same token as apps/web) ────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── AI content providers — used by the research pipeline's ideation step ───
# OpenAI is tried first, then Gemini, then Groq.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ── Research Lab prior-art search ───────────────────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=
PATENTSVIEW_API_KEY=
RESEARCH_CONTACT_EMAIL=

# ── ffmpeg overrides (leave blank to use the bundled ffmpeg-static/ffprobe-static) ──
FFMPEG_PATH=
FFPROBE_PATH=
# Optional local path to an mp3 mixed under every lesson video, if bundled into the worker image.
BACKGROUND_MUSIC_PATH=

# ── Render injects this automatically; only needed for local dev ──────────
PORT=4000
