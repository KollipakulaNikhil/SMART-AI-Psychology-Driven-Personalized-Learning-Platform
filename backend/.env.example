# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/smart-ai

# ── Firebase Admin (token verification) ───────────────────────────────────
# Option A: path to a downloaded service-account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
# Option B: inline credentials (used if the path above is not set)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; \n stays escaped inside the value
FIREBASE_PRIVATE_KEY=""

# ── AI content providers — set at least one; Gemini is tried first, Groq is
# ── the automatic fallback if Gemini errors out or is unconfigured ────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Used automatically when the primary model is rate-limited (bigger TPM budget)
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# ── Pexels (slide imagery) ────────────────────────────────────────────────
PEXELS_API_KEY=

# ── ElevenLabs (narration) — OPTIONAL ─────────────────────────────────────
# If empty or out of quota, narration automatically falls back to the FREE
# Microsoft Edge neural voice (no key, no quota, works in the downloadable
# video). Set a key here only for premium ElevenLabs voices.
ELEVENLABS_API_KEY=
# Optional overrides — sensible defaults are built in
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_FRIENDLY=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_PROFESSIONAL=ErXwobaYiN019PkySvjV
ELEVENLABS_VOICE_ACADEMIC=onwK4e9ZLuTAKqWW03F9

# ── Video ─────────────────────────────────────────────────────────────────
# ffmpeg/ffprobe binaries ship via npm (ffmpeg-static); override only if needed
FFMPEG_PATH=
FFPROBE_PATH=
# Optional: absolute path to an mp3 mixed under the narration at low volume
BACKGROUND_MUSIC_PATH=

# ── Talking-head avatar (optional) — see backend/avatar/README.md ─────────
# Leave AVATAR_ENABLED=false to ship a board-only video (voice + animated board).
# Turn on only after completing the one-time Python + model setup.
AVATAR_ENABLED=false
AVATAR_ENGINE=wav2lip
# Absolute path to your python (ideally a venv), e.g. C:/wav2lip/.venv/Scripts/python.exe
PYTHON_BIN=
# Absolute path to the cloned Wav2Lip (or SadTalker) repo
AVATAR_REPO_DIR=
# Checkpoint path — relative to AVATAR_REPO_DIR or absolute
WAV2LIP_CHECKPOINT=checkpoints/wav2lip_gan.pth
# A presenter face: a portrait photo or short face video (mp4)
AVATAR_FACE_IMAGE=
# Hard timeout for one lesson's lip-sync render (minutes)
AVATAR_TIMEOUT_MIN=25

# ── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
GENERATION_RATE_LIMIT_MAX=30
